  }catch(e){$('backupStatus').textContent=e.message;}finally{button.disabled=false;}
};
$('restoreBackup').onclick=async()=>{
  const button=$('restoreBackup');button.disabled=true;
  try{
    const file=$('backupFile').files?.[0];if(!file)throw Error('Choose an .emma backup first.');
    if(file.size>20*1024*1024)throw Error('This file is too large for the prototype.');
    const restored=await decryptBackup(await file.text(),$('backupPassword').value);
    if(!confirm('Restore '+(restored.patient.preferredName||'this patient')+'’s Emma? This replaces the current records with '+restored.events.length+' Journey entries, '+restored.memories.length+' memories and '+restored.openLoops.length+' follow-up items. Export your current records first if you want to keep both.'))return;
    stopRealtime();persistState(localStorage,restored,{allowRecovery:true});state=restored;persisted=structuredClone(state);storageError=null;
    state.medicationPending=null;state.memoryPending=null;transcript=[];$('conversation').innerHTML='';$('backupPassword').value='';render();
    $('backupStatus').textContent='Your Emma is restored. You can start a new conversation.';
  }catch(e){$('backupStatus').textContent=e.message;}finally{button.disabled=false;}
};
$('recoverPrevious').onclick=()=>{
  try{
    const raw=localStorage.getItem(PREVIOUS_KEY);if(!raw)throw Error('There is no previous saved version on this browser.');
    const previous=validateState(JSON.parse(raw));
    if(!confirm('Restore the previous saved version from '+(previous.lastUpdated||'an earlier session')+'? Newer changes will be replaced.'))return;
    stopRealtime();persistState(localStorage,previous,{allowRecovery:true});state=previous;persisted=structuredClone(state);storageError=null;render();
    $('backupStatus').textContent='Previous saved version restored.';
  }catch(e){$('backupStatus').textContent=e.message;}
};
// Recoverable UI errors stay visible instead of acknowledging unsaved changes.
for(const id of ['resetBtn','energyToggle','confirmMemory','cancelMemory','recoverPrevious']){
  const element=$(id),handler=element.onclick;
  element.onclick=async e=>{try{await handler(e);}catch{setVoiceUI('Couldn’t save','Your last saved information is unchanged. Please try again.');}};
}
globalThis.addEventListener?.('storage',e=>{
  if(e.key!==STORE_KEY)return;
  stopRealtime();storageError='Emma’s data changed in another tab. Reload this tab before continuing.';render();
});


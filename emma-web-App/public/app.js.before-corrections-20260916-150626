function sendEvent(evt){if(dc?.readyState==='open')dc.send(JSON.stringify(evt))}function stopRealtime(){voiceVisuals.stop();$('muteToggle').disabled=true;$('muteToggle').textContent='Mute';$('muteToggle').setAttribute?.('aria-pressed','false');$('listeningLabel').textContent='Ready when you are';connectionGeneration++;latestMedicationRequest++;connecting=false;connected=false;greetingPending=false;micStream?.getTracks().forEach(t=>t.stop());micStream=null;dc?.close();dc=null;pc?.close();pc=null;talkBtn.classList.remove('live');talkToggle.textContent='Start conversation';setVoiceUI('Talk to Emma','Tap once, then speak normally.')}function handleRealtimeEvent(evt){
